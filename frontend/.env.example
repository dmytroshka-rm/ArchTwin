# Backend API (production).
# Locally leave unset — Vite proxies /api → localhost:8000.
# On Vercel you can either leave unset and proxy /api in frontend/vercel.json → Railway,
# or set VITE_API_ORIGIN=https://your-api.up.railway.app and redeploy.
# VITE_API_ORIGIN=

# Firebase — Firebase Console → Project settings → Your apps → Web app
# Copy this file to .env and fill in values (never commit .env).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# "Sender ID" in the same Firebase web config snippet
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — only if you use Analytics (Measurement ID)
# VITE_FIREBASE_MEASUREMENT_ID=
